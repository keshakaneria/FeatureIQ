# Neon Postgres connection string
# Get this from: https://console.neon.tech → Your Project → Connection Details
DATABASE_URL=postgresql://username:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Local Node server port
PORT=3001

# In Cloudflare Workers, set DATABASE_URL with:
# npx wrangler secret put DATABASE_URL
